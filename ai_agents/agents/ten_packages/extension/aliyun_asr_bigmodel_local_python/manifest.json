{
    "type": "extension",
    "name": "aliyun_asr_bigmodel_local_python",
    "version": "0.2.3",
    "dependencies": [
        {
            "type": "system",
            "name": "ten_runtime_python",
            "version": "0.11"
        },
        {
            "type": "system",
            "name": "ten_ai_base",
            "version": "0.7"
        }
    ],
    "api": {
        "property": {
            "properties": {
                "params": {
                    "type": "object",
                    "properties": {
                        "asr_backend": {
                            "type": "string"
                        },
                        "language_hints": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "sample_rate": {
                            "type": "int64"
                        },
                        "funasr_host": {
                            "type": "string"
                        },
                        "funasr_port": {
                            "type": "string"
                        },
                        "funasr_is_ssl": {
                            "type": "bool"
                        },
                        "funasr_chunk_size": {
                            "type": "string"
                        },
                        "funasr_chunk_interval": {
                            "type": "int64"
                        },
                        "funasr_mode": {
                            "type": "string"
                        },
                        "funasr_hotwords": {
                            "type": "string"
                        },
                        "funasr_itn": {
                            "type": "bool"
                        },
                        "dump": {
                            "type": "bool"
                        },
                        "dump_path": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "start": "scripts/start.sh"
    }
}
